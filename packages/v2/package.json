{
  "name": "opencode-profile-switcher-v2",
  "version": "0.1.1",
  "description": "OpenCode 2.0 plugin to define model profiles (agent-to-tier assignments) and switch them live from the UI.",
  "license": "MIT",
  "author": "Gino Novello",
  "type": "module",
  "engines": {
    "opencode": ">=2.0.29"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinoNovello/opencode-profile-switcher.git",
    "directory": "packages/v2"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "profiles",
    "models",
    "llm"
  ],
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./rpc": {
      "import": "./dist/rpc.js",
      "types": "./dist/rpc.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.29 <3",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@types/bun": "1.3.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2",
    "@opencode/theme": "2.0.29",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.12"
  }
}
