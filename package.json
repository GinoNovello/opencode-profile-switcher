{
  "name": "opencode-profile-switcher",
  "version": "0.1.8",
  "description": "opencode plugin to define model profiles (agent-to-tier assignments) and switch them live from the UI.",
  "license": "MIT",
  "author": "Gino Novello",
  "type": "module",
  "engines": {
    "opencode": ">=1.18.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinoNovello/opencode-profile-switcher.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "profiles",
    "models",
    "llm"
  ],
  "exports": {
    ".": {
      "import": "./dist/v1/server.js",
      "types": "./dist/v1/server.d.ts"
    },
    "./server": {
      "import": "./dist/v1/server.js",
      "types": "./dist/v1/server.d.ts"
    },
    "./tui": {
      "import": "./dist/v1/tui.js",
      "types": "./dist/v1/tui.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:smoke": "bun run build && bun test ./test/live-switch.smoke.ts",
    "typecheck:v2": "bun run --cwd packages/v2 typecheck",
    "test:v2": "bun run --cwd packages/v2 test",
    "build:v2": "bun run --cwd packages/v2 build",
    "check": "bun run typecheck && bun test && bun run build && bun run typecheck:v2 && bun run test:v2 && bun run build:v2",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.10"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.10",
    "@opencode-ai/sdk": "1.18.10",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
